{
    "manifest_version": 3,
    "name": "Content Templatizer",
    "version": "1.0",
    "description": "AI-powered content templatizer for social media posts",
    "permissions": ["activeTab", "storage", "tabs"],
    "host_permissions": [
      "http://localhost:3000/*"
    ],
    "action": {
      "default_popup": "popup.html"
    },
    "content_scripts": [
      {
        "matches": ["https://*.linkedin.com/*", "https://*.twitter.com/*"],
        "js": ["content.js"]
      }
    ]
  }