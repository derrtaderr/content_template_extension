{
    "manifest_version": 3,
    "name": "Content Templatizer",
    "version": "1.0",
    "description": "AI-powered content templatizer for social media posts",
    "permissions": ["activeTab", "storage"],
    "host_permissions": [
      "https://*.linkedin.com/*",
      "https://api.anthropic.com/*"
    ],
    "action": {
      "default_popup": "popup.html"
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["https://*.linkedin.com/*"],
        "js": ["content.js"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["api.js", "templateManager.js"],
        "matches": ["<all_urls>"]
      }
    ]
  }