{
    "manifest_version": 3,
    "name": "Content Templatizer",
    "version": "1.0",
    "description": "AI-powered content templatizer for social media posts",
    "permissions": [
      "activeTab",
      "storage"
    ],
    "host_permissions": [
      "https://*.linkedin.com/*",
      "https://*.twitter.com/*",
      "https://api.anthropic.com/*"
    ],
    "action": {
      "default_popup": "popup.html"
    },
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
    "content_scripts": [
      {
        "matches": [
          "https://*.linkedin.com/*",
          "https://*.twitter.com/*"
        ],
        "js": ["content.js"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["api.js"],
        "matches": ["<all_urls>"]
      }
    ]
  }